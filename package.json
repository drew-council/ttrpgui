{
  "name": "ttrpgui",
  "main": "src/electron.ts",
  "type": "module",
  "private": true,
  "imports": {
    "#components/*": "./src/client/components/*"
  },
  "scripts": {
    "start": "vite build && CHROME_DEVEL_SANDBOX= electron .",
    "dev": "vite",
    "build": "vite build",
    "cli": "node src/cli.ts",
    "check": "tsc --noEmit && biome check src harness vite.config.ts",
    "shots": "vite build && node harness/shots.ts",
    "smoke": "vite build && xvfb-run -a -s '-screen 0 1280x800x24' node harness/electron-smoke.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "playwright": "1.64.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "chokidar": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fuzzysort": "^4.0.2",
    "immer": "^11.2.10",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sirv": "^3.0.2",
    "smol-toml": "^1.9.1",
    "sonner": "^2.0.8",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
