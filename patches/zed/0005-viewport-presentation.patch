+
+#[gpui::test]
+async fn test_large_note_presentation_follows_scroll_and_source_scope(cx: &mut TestAppContext) {
+    let mut cx = markdown_test_context(cx).await;
+    let text = (0..500)
+        .map(|row| format!("row {row} **bold** *italic* [link](relative.md)\n"))
+        .collect::<String>();
+    cx.set_state(&format!("ˇ{text}"));
+    cx.executor().run_until_parked();
+    assert!(cx.display_text().contains("row 1 bold italic link"));
+    assert!(cx.display_text().contains("row 400 **bold**"));
+
+    // Scrolling without changing the selection must decorate the newly
+    // visible source rows. Distant tokens stay out of the display maps.
+    cx.update_editor(|editor, window, cx| {
+        let snapshot = editor.buffer().read(cx).snapshot(cx);
+        editor.set_scroll_anchor(
+            editor::scroll::ScrollAnchor {
+                anchor: snapshot.anchor_before(Point::new(400, 0)),
+                offset: Default::default(),
+            },
+            window,
+            cx,
+        );
+    });
+    cx.executor().run_until_parked();
+    assert!(cx.display_text().contains("row 400 bold italic link"));
+    assert!(cx.display_text().contains("row 1 **bold**"));
+
+    cx.update_editor(|editor, _, cx| {
+        editor.with_source_display(cx, |editor, cx| {
+            let snapshot = editor.display_snapshot(cx);
+            assert_eq!(snapshot.text(), text);
+        });
+    });
+    cx.executor().run_until_parked();
+    assert_eq!(cx.buffer_text(), text);
+    assert!(cx.display_text().contains("row 400 bold italic link"));
+
+    cx.dispatch_action(ToggleLivePreview);
+    cx.executor().run_until_parked();
+    assert_eq!(cx.display_text(), text);
+    cx.dispatch_action(ToggleLivePreview);
+    cx.executor().run_until_parked();
+    assert!(cx.display_text().contains("row 400 bold italic link"));
 }
 
