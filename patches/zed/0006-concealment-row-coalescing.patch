+/// Concealment edits never change inlay text (`old == new`), so edits sharing
+/// a row can be widened into one. Tab and wrap maps then rescan each line once
+/// rather than once per concealed marker on it.
+fn merge_same_row_edits(snapshot: &InlaySnapshot, edits: Vec<InlayEdit>) -> Vec<InlayEdit> {
+    let mut merged: Vec<InlayEdit> = Vec::with_capacity(edits.len());
+    let mut last_row = None;
+    for edit in edits {
+        debug_assert_eq!(edit.old, edit.new);
+        let start_row = snapshot.to_point(edit.old.start).row();
+        match merged.last_mut() {
+            Some(previous) if last_row == Some(start_row) => {
+                previous.old.end = edit.old.end;
+                previous.new.end = edit.new.end;
+            }
+            _ => merged.push(edit),
+        }
+        last_row = merged
+            .last()
+            .map(|edit| snapshot.to_point(edit.old.end).row());
+    }
+    merged
+}
