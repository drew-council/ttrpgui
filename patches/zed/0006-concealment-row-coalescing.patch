+        let (_, inlay_snapshot) = InlayMap::new(buffer_snapshot.clone());
+        let mut map = FoldMap::new(inlay_snapshot.clone()).0;
+        let owner = std::any::TypeId::of::<FoldMap>();
+        let markers = text
+            .match_indices("**")
+            .map(|(start, _)| Concealment {
+                range: buffer_snapshot.anchor_after(MultiBufferOffset(start))
+                    ..buffer_snapshot.anchor_before(MultiBufferOffset(start + 2)),
+                placeholder: FoldPlaceholder::test(),
+                content_key: 0,
+            })
+            .collect::<Vec<_>>();
+        assert_eq!(markers.len(), 6);
+
+        // Four markers on the first row and two on the last: one edit per row.
+        let (mut writer, _, _) = map.write(inlay_snapshot.clone(), vec![]);
+        let (snapshot, edits) = writer.set_concealments(owner, markers);
+        assert_eq!(snapshot.text(), "⋯a⋯ and ⋯b⋯\nplain\n⋯c⋯");
+        assert_eq!(edits.len(), 2);
+
+        let (mut writer, _, _) = map.write(inlay_snapshot, vec![]);
+        let (snapshot, edits) = writer.set_concealments(owner, Vec::new());
+        assert_eq!(snapshot.text(), text);
+        assert_eq!(edits.len(), 2);
+    }
