+    /// Run a buffer-coordinate operation without addon-owned display aliases.
+    /// Other folds and all buffer state retain their ordinary editor semantics.
+    pub fn with_source_display<R>(
+        &mut self,
+        cx: &mut Context<Self>,
+        operation: impl FnOnce(&mut Self, &mut Context<Self>) -> R,
+    ) -> R {
+        let hooks: Vec<_> = self
+            .addons
+            .values()
+            .filter_map(|addon| addon.source_display_hooks())
+            .collect();
+        for hook in &hooks {
+            (hook.enter)(self, cx);
+        }
+        let result = operation(self, cx);
+        for hook in hooks.iter().rev() {
+            (hook.exit)(self, cx);
+        }
+        result
+    }
