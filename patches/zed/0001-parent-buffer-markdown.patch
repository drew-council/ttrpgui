+#[gpui::test]
+async fn test_cell_click_uses_parent_buffer_without_mutation(cx: &mut TestAppContext) {
+    let mut cx = markdown_test_context(cx).await;
+    cx.set_state("ˇintro\n\n| Name | HP |\n| --- | --- |\n| Éowyn | 12 |\n");
+    cx.executor().run_until_parked();
+    let before = cx.buffer_text();
+    let (weak, cell) = cx.update_editor(|editor, _, cx| {
+        let snapshot = editor.buffer().read(cx).snapshot(cx);
+        let (_, table) = parse_table_at(&snapshot, MultiBufferOffset(7)).unwrap();
+        (cx.weak_entity(), table.rows[0][0].clone())
+    });
+    cx.update(|window, cx| start_cell_edit(weak, cell, window, cx));
+    cx.executor().run_until_parked();
+    assert_eq!(cx.buffer_text(), before);
+    assert_eq!(applied_block_count(&mut cx), 0);
+    cx.update_editor(|editor, window, cx| {
+        assert!(editor.focus_handle(cx).is_focused(window));
+    });
+    cx.assert_editor_state("intro\n\n| Name | HP |\n| --- | --- |\n| ˇÉowyn | 12 |\n");
+}
