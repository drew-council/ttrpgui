+fn enter_source_operation(editor: &mut Editor, cx: &mut Context<Editor>) {
+    let Some(addon) = editor.addon_mut::<LivePreviewAddon>() else {
+        return;
+    };
+    addon.source_operation_depth += 1;
+    if addon.source_operation_depth != 1 {
+        return;
+    }
+    addon.suspended_blocks = std::mem::take(&mut addon.applied_blocks);
+    let ids: HashSet<_> = addon
+        .suspended_blocks
+        .iter()
+        .map(|block| block.block_id)
+        .collect();
+    editor.set_concealments(TypeId::of::<LivePreviewFoldTag>(), Vec::new(), cx);
+    if !ids.is_empty() {
+        editor.remove_blocks(ids, None, cx);
+    }
+}
+
+fn exit_source_operation(editor: &mut Editor, cx: &mut Context<Editor>) {
+    let Some(addon) = editor.addon_mut::<LivePreviewAddon>() else {
+        return;
+    };
+    addon.source_operation_depth -= 1;
+    if addon.source_operation_depth != 0 {
+        return;
+    }
+    let mut blocks = std::mem::take(&mut addon.suspended_blocks);
+    if !blocks.is_empty() {
+        // Reuse the rendered entities and callbacks; do not reparse every block
+        // just because a motion temporarily needed canonical source coordinates.
+        let ids = editor.insert_blocks(
+            blocks.iter().map(|block| block.properties.clone()),
+            None,
+            cx,
+        );
+        for (block, id) in blocks.iter_mut().zip(ids) {
+            block.block_id = id;
+        }
+    }
+    if let Some(addon) = editor.addon_mut::<LivePreviewAddon>() {
+        addon.applied_blocks = blocks;
+    }
+    apply_decorations(editor, cx);
 }
 
