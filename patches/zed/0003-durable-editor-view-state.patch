+impl Editor {
+    /// Persist view metadata immediately after the serialized item exists.
+    /// Quit callers must await this rather than relying on throttled selection
+    /// and scroll writes, which can otherwise be cancelled during shutdown.
+    pub fn flush_view_state(
+        &mut self,
+        workspace_id: WorkspaceId,
+        _window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<()>> {
+        self.serialize_selections = Task::ready(());
+        let snapshot = self.buffer().read(cx).snapshot(cx);
+        let selections = self.selections.disjoint_anchors_arc().iter()
+            .map(|selection| (selection.start.to_offset(&snapshot).0, selection.end.to_offset(&snapshot).0))
+            .collect();
+        self.scroll_manager.cancel_pending_serialization();
+        let display = self.display_map.update(cx, |map, cx| map.snapshot(cx));
+        let anchor = self.scroll_manager.native_anchor(&display, cx);
+        let top_row = anchor.anchor.to_point(&snapshot).row;
+        let item_id = cx.entity().entity_id().as_u64();
+        let db = EditorDb::global(cx);
+        cx.background_spawn(async move {
+            db.save_editor_selections(item_id, workspace_id, selections).await?;
+            db.save_scroll_position(item_id, workspace_id, top_row, anchor.offset.x, anchor.offset.y).await?;
+            Ok(())
+        })
+    }
